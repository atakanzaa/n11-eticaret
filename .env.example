# SmartCommerce environment template.
# Copy to .env (gitignored) and fill in real values for IYZICO_*, AI_API_KEY.
# Defaults below work for local dev; only the marked secrets need real values.

# ── Spring profile ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ── Database (postgres in docker) ──────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=smartcommerce
DB_PASSWORD=smartcommerce

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:29092

# ── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartcommerce
RABBITMQ_PASSWORD=smartcommerce

# ── OpenSearch ─────────────────────────────────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http

# ── JWT (HS256 needs >= 256-bit secret) ───────────────────────────
# Generate a fresh one with:  openssl rand -base64 64
# Never share or reuse across environments.
JWT_SECRET=replace-with-openssl-rand-base64-64-output

# ── Iyzico (REQUIRED for payment-service) ──────────────────────────
# Get from https://sandbox-merchant.iyzipay.com
IYZICO_API_KEY=sandbox-replace-me
IYZICO_SECRET_KEY=sandbox-replace-me
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:8090/api/payments/iyzico/callback

# ── Public-facing host (REQUIRED when not on localhost) ───────────
# When deploying behind a real host/IP, set both to the public origin so:
#   - Gateway CORS allows the SPA's own browser traffic.
#   - The 3DS post-callback 303 redirect lands on the same origin (otherwise
#     the result page polls /api/payments/{id} on localhost:4200 and breaks).
# For pure local dev, leave these unset — the defaults in application.yml /
# docker-compose.services.yml resolve to http://localhost:4200/8080.
APP_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
FRONTEND_URL=http://localhost:4200

# ── AI provider (REQUIRED for ai-orchestrator) ─────────────────────
# Pick ONE provider: anthropic | openai | gemini
# AI_API_KEY format:
#   anthropic -> sk-ant-...
#   openai    -> sk-...
#   gemini    -> AIza...
# AI_MODEL is optional; adapter falls back to a sensible default if blank
#   anthropic default: claude-sonnet-4-6
#   openai    default: gpt-4o-mini
#   gemini    default: gemini-2.0-flash
AI_PROVIDER=anthropic
AI_API_KEY=replace-me
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_DAILY_BUDGET_USD=10.00
