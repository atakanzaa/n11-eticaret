  "panels": [
    {
      "type": "stat",
      "title": "Services Up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(up{job=\"smartcommerce-services\"})", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate per service (req/min)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)", "refId": "A", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency per service",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (application, le))", "refId": "A", "legendFormat": "{{application}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (application)", "refId": "A", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "jvm_memory_used_bytes{area=\"heap\"}", "refId": "A", "legendFormat": "{{application}} {{id}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "type": "timeseries",
      "title": "DB connection pool usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "hikaricp_connections_active", "refId": "A", "legendFormat": "{{application}} active"},
        {"expr": "hikaricp_connections_max", "refId": "B", "legendFormat": "{{application}} max"}
      ]
    }
  ],
