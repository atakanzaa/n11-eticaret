              "mode": "raw",
              "raw": "{\"email\":\"customer@test.com\",\"password\":\"Password123!\",\"firstName\":\"John\",\"lastName\":\"Doe\",\"roles\":[\"CUSTOMER\"]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('accessToken', r.accessToken);",
                  "pm.environment.set('customerAccessToken', r.accessToken);",
                  "pm.environment.set('refreshToken', r.refreshToken);",
