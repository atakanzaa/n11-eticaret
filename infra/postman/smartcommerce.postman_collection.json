    {
      "name": "Payments (Day 4)",
      "item": [
        {
          "name": "Initiate Payment (3DS)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"installment\": 1,\n  \"card\": {\n    \"holderName\": \"Atakan Yel\",\n    \"number\": \"5528790000000008\",\n    \"expireMonth\": \"12\",\n    \"expireYear\": \"2030\",\n    \"cvc\": \"123\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "initiate"]
            },
            "description": "Iyzico sandbox test cards: 5528790000000008 (Mastercard success), 5400360000000003 (Mastercard 3DS), 5406670000000009 (insufficient), 5406670000000017 (do-not-honor). Sandbox OTP: 123456."
          }
        },
        {
          "name": "Iyzico 3DS Callback (simulated)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/x-www-form-urlencoded"}
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "status", "value": "success"},
                {"key": "paymentId", "value": "iyz-pay-id-from-initiate"},
                {"key": "conversationId", "value": "conv-from-initiate"},
                {"key": "mdStatus", "value": "1"}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/iyzico/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "iyzico", "callback"]
            }
          }
        },
