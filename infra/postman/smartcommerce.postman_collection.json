{
  "info": {
    "_postman_id": "smartcommerce-v1",
    "name": "SmartCommerce API",
    "description": "SmartCommerce API collection for n11 showcase project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"customer@test.com\",\"password\":\"Password123!\",\"firstName\":\"John\",\"lastName\":\"Doe\",\"roles\":[\"CUSTOMER\"]}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.environment.set('accessToken', r.accessToken);",
                "pm.environment.set('refreshToken', r.refreshToken);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }]
        },
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"seller@test.com\",\"password\":\"Password123!\",\"firstName\":\"Jane\",\"lastName\":\"Smith\",\"roles\":[\"SELLER\"]}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.environment.set('accessToken', r.accessToken);",
                "pm.environment.set('refreshToken', r.refreshToken);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"seller@test.com\",\"password\":\"Password123!\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.environment.set('accessToken', r.accessToken);",
                "pm.environment.set('refreshToken', r.refreshToken);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ]
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.environment.set('accessToken', r.accessToken);",
                "pm.environment.set('refreshToken', r.refreshToken);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ]
            }
          }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            }
          }
        },
        {
          "name": "Me (Current User)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Sellers",
      "item": [
        {
          "name": "Get My Seller Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/api/sellers/me"
          }
        },
        {
          "name": "Update My Seller Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/api/sellers/me",
            "body": {
              "mode": "raw",
              "raw": "{\"storeName\":\"My Updated Store\",\"description\":\"Best store in town\"}"
            }
          }
        }
      ]
    }
  ]
}
